<aura:component>
		<aura:registerEvent name="addItem" type="c:addItemEvent"/>
        <aura:attribute name="newItem" type="Camping_Item__c" default="{
                        'Quantity__c': 0,
                        'Price__c': 0,
                        'Packed__c': false}"/>
             
		<form class="slds-form_stacked">
            <lightning:input aura:id="campingform"
            				 label="Name"
                             value="{!v.newItem.Name}"
                             required="true"/>

            <lightning:input aura:id="campingform"
            				 type="number" label="Quantity"
                             min="1"
                             value="{!v.newItem.Quantity__c}"
                             required="true"/>

            <lightning:input aura:id="campingform"
            				 label="Price"
            				 type="number"
            				 value="{!v.newItem.Price__c}"
            				 formatter="currency"/>
            <!-- 给复选框赋值用checked -->
            <lightning:input aura:id="campingform"
            				 type="checkbox" label="Packed?"
                             checked="{!v.newItem.Packed__c}"
                             />
            <lightning:button variant="brand"
            				  label="Create Camping Item"
            				  onclick="{!c.clickCreateItem}">
            </lightning:button>
        </form>


</aura:component>